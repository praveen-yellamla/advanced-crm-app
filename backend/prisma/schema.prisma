generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// 1. SAAS PLATFORM LAYER (Multi-Tenant)
// ==========================================

model Organization {
  id            Int      @id @default(autoincrement())
  name          String
  slug          String   @unique
  logoUrl       String?  @map("logo_url")
  faviconUrl    String?  @map("favicon_url")
  industry      String?
  website       String?
  
  // Branding
  primaryColor  String?  @default("#2563EB") @map("primary_color")
  secondaryColor String? @default("#0F172A") @map("secondary_color")
  
  // Subscription Info
  planId        Int?     @map("plan_id")
  plan          Plan?    @relation(fields: [planId], references: [id])
  subscriptionTier SubscriptionTier @default(STARTER) @map("subscription_tier")
  billingCycle  BillingCycle     @default(MONTHLY) @map("billing_cycle")
  status           OrgStatus        @default(ACTIVE)
  
  // Usage Tracking (Current Overrides/Limits)
  agentLimit       Int @default(5)    @map("agent_limit")
  managerLimit     Int @default(1)    @map("manager_limit")
  leadLimit        Int @default(1000)  @map("lead_limit")
  storageLimitMb   Int @default(512)   @map("storage_limit_mb")
  aiTokenLimit     Int @default(10000) @map("ai_token_limit")
  callMinutesLimit Int @default(100)   @map("call_minutes_limit")
  campaignLimit    Int @default(5)     @map("campaign_limit")
  
  // Billing Info
  billingEmail     String?  @map("billing_email")
  billingAddress   Json?    @map("billing_address") // { city, country, line1, postal_code, state }
  taxId            String?  @map("tax_id")
  
  stripeCustomerId String? @map("stripe_customer_id")
  stripeSubscriptionId String? @map("stripe_subscription_id")
  
  currentPeriodStart DateTime? @map("current_period_start")
  currentPeriodEnd   DateTime? @map("current_period_end")
  subscriptionExpiresAt DateTime? @map("subscription_expires_at")
  cancelAtPeriodEnd Boolean @default(false) @map("cancel_at_period_end")
  autoRenew        Boolean @default(true) @map("auto_renew")
  
  // Relations
  users     User[]
  leads     Lead[]
  teams     Team[]
  tasks     Task[]
  calls     Call[]
  invoices  Invoice[] // CRM Business Invoices
  platformInvoices PlatformInvoice[] // SaaS Subscription Invoices
  transactions PlatformTransaction[]
  settings  OrganizationSetting[]
  auditLogs AuditLog[]
  aiUsage   AIUsage[]
  emails    Email[]
  emailAccounts EmailAccount[]
  leadActivities LeadActivity[]
  callQAs   CallQA[]
  feedbacks Feedback[]
  invites   Invite[]
  notifications Notification[]
  
  // Security & Compliance
  twoFactorEnabled Boolean @default(false) @map("two_factor_enabled")
  ipWhitelist      String?  @map("ip_whitelist")
  accessApprovalRequired Boolean @default(false) @map("access_approval_required")
  lastPlatformAccessAt   DateTime? @map("last_platform_access_at")
  lastPlatformAccessBy   String?   @map("last_platform_access_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("organizations")
}

model Plan {
  id            Int      @id @default(autoincrement())
  name          String   // Starter, Professional, Enterprise
  tier          SubscriptionTier @unique
  description   String?
  priceMonthly  Float    @map("price_monthly")
  priceYearly   Float    @map("price_yearly")
  
  // Usage Limits
  userLimit       Int      @map("user_limit")
  managerLimit    Int      @default(1) @map("manager_limit")
  leadLimit       Int      @map("lead_limit")
  storageLimitMb  Int      @default(512) @map("storage_limit_mb")
  aiTokenLimit    Int      @map("ai_token_limit")
  callMinutesLimit Int     @default(100) @map("call_minutes_limit")
  campaignLimit   Int      @default(5) @map("campaign_limit")
  pipelineLimit   Int      @default(3) @map("pipeline_limit")
  
  // Feature Toggles (Explicit for gating)
  aiAssistant       Boolean @default(false) @map("ai_assistant")
  aiLeadScoring     Boolean @default(false) @map("ai_lead_scoring")
  aiVoiceCalls      Boolean @default(false) @map("ai_voice_calls")
  callingEnabled    Boolean @default(false) @map("calling_enabled")
  callRecording     Boolean @default(false) @map("call_recording")
  smsEnabled        Boolean @default(false) @map("sms_enabled")
  whatsappEnabled   Boolean @default(false) @map("whatsapp_enabled")
  monitoringEnabled Boolean @default(false) @map("monitoring_enabled")
  automationEnabled Boolean @default(false) @map("automation_enabled")
  analyticsEnabled  Boolean @default(false) @map("analytics_enabled")
  advancedReports   Boolean @default(false) @map("advanced_reports")
  customBranding    Boolean @default(false) @map("custom_branding")
  prioritySupport   Boolean @default(false) @map("priority_support")
  apiAccess         Boolean @default(false) @map("api_access")
  webhooksEnabled   Boolean @default(false) @map("webhooks_enabled")
  auditLogsEnabled  Boolean @default(false) @map("audit_logs_enabled")
  
  // Billing Config
  freeTrialDays     Int     @default(0) @map("free_trial_days")
  setupFee          Float   @default(0) @map("setup_fee")
  
  // Metadata
  features      Json     
  isActive      Boolean  @default(true) @map("is_active")
  isPublic      Boolean  @default(true) @map("is_public")
  
  organizations Organization[]
  
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("plans")
}

model PlatformInvoice {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])
  
  invoiceNo      String   @unique @map("invoice_no")
  amount         Float
  subtotal       Float?
  tax            Float?
  discount       Float?
  currency       String   @default("INR")
  status         PlatformInvoiceStatus @default(PENDING)
  billingDate    DateTime @map("billing_date")
  paidAt         DateTime? @map("paid_at")
  
  periodStart    DateTime? @map("period_start")
  periodEnd      DateTime? @map("period_end")
  
  stripeInvoiceId String? @map("stripe_invoice_id")
  invoiceUrl     String?  @map("invoice_url")
  pdfUrl         String?  @map("pdf_url")
  
  createdAt      DateTime @default(now()) @map("created_at")
  
  @@map("platform_invoices")
}

model PlatformTransaction {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])
  
  transactionId  String   @unique @map("transaction_id") // Provider's payment ID
  orderId        String?  @map("order_id") // Provider's order ID
  
  amount         Float
  currency       String   @default("INR")
  status         TransactionStatus @default(PENDING)
  gateway        String?  // stripe, razorpay
  method         String?  // card, upi, etc.
  
  description    String?
  errorMessage   String?  @map("error_message")
  
  metadata       Json?
  
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  
  @@map("platform_transactions")
}

model Notification {
  id             Int      @id @default(autoincrement())
  organizationId Int?     @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id])
  userId         Int?     @map("user_id")
  user           User?    @relation(fields: [userId], references: [id])
  
  title          String
  message        String
  type           NotificationType @default(INFO)
  priority       NotificationPriority @default(MEDIUM)
  isRead         Boolean  @default(false) @map("is_read")
  
  link           String?
  metadata       Json?
  
  createdAt      DateTime @default(now()) @map("created_at")
  
  @@map("notifications")
}

model PlatformSetting {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       Json
  description String?
  category    String   @default("GENERAL")
  
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  @@map("platform_settings")
}

enum SubscriptionTier {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum OrgStatus {
  ACTIVE
  TRIAL
  SUSPENDED
  CANCELLED
}

enum PlatformInvoiceStatus {
  PENDING
  PAID
  VOID
  UNCOLLECTIBLE
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  BILLING
  SECURITY
  SYSTEM
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ==========================================
// 2. USER & ACCESS CONTROL
// ==========================================

model User {
  id           Int     @id @default(autoincrement())
  name         String
  email        String  @unique
  password     String
  phone        String? @unique
  profileImage String?
  
  // Role & Scope
  role         Role    @default(AGENT)
  
  // Tenant Isolation
  organizationId Int?  @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id])
  
  isActive     Boolean @default(true) @map("is_active")
  
  // Workspace Layout / State
  lastWorkspaceId Int? @map("last_workspace_id")

  // Performance Targets
  dailyCallsTarget       Int @default(0) @map("daily_calls_target")
  monthlySalesTarget     Int @default(0) @map("monthly_sales_target")
  monthlyFollowupsTarget Int @default(0) @map("monthly_followups_target")

  // Relations
  teamId Int?  @map("team_id")
  team   Team? @relation("TeamAgents", fields: [teamId], references: [id])

  managerId Int?   @map("manager_id")
  manager   User?  @relation("AgentManager", fields: [managerId], references: [id])
  agents    User[] @relation("AgentManager")
  managedTeams Team[] @relation("TeamManager")

  calls         Call[]
  assignedLeads Lead[]     @relation("AssignedLeads")
  tasksAssigned Task[]     @relation("TaskAssignee")
  tasksCreated  Task[]     @relation("TaskCreator")
  auditLogs     AuditLog[]
  invoices      Invoice[]  @relation("InvoiceRaisedBy")
  emailsSent    Email[]    @relation("AgentEmails")
  qaPerformed   CallQA[]   @relation("QAManager")
  feedbacksReceived Feedback[] @relation("AgentFeedback")
  feedbacksGiven    Feedback[] @relation("ManagerFeedback")
  aiUsage       AIUsage[]
  emailAccounts EmailAccount[]
  notifications Notification[]

  failedLoginAttempts Int @default(0) @map("failed_login_attempts")
  lockedUntil       DateTime? @map("locked_until")

  sessions      Session[]
  
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  agentType    AgentType?         @default(MANUAL) @map("agent_type")
  inviteStatus AgentInviteStatus? @map("invite_status")

  @@index([email])
  @@index([organizationId])
  @@map("users")
}

model Session {
  id           String   @id @default(uuid())
  userId       Int      @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  token        String   @unique // The access token associated with this session
  refreshToken String?  @unique @map("refresh_token")
  
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  deviceName   String?  @map("device_name")
  location     String?
  
  isActive     Boolean  @default(true) @map("is_active")
  isPersistent Boolean  @default(false) @map("is_persistent") // If "Remember Me" was checked
  
  expiresAt    DateTime @map("expires_at")
  lastUsedAt   DateTime @default(now()) @map("last_used_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("sessions")
}

enum Role {
  SUPER_ADMIN      // Platform Owner
  PLATFORM_BILLING // SaaS Billing Ops
  PLATFORM_SUPPORT // SaaS Technical Support
  ADMIN            // Company Admin
  MANAGER          // Company Manager
  AGENT            // Company Agent
}

enum AgentType {
  MANUAL
  INVITED
}

enum AgentInviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

// ==========================================
// 3. CRM MODELS (Tenant Scoped)
// ==========================================

model Team {
  id         Int     @id @default(autoincrement())
  organizationId Int  @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])
  
  teamName   String  @map("team_name")
  isActive   Boolean @default(true) @map("is_active")

  managerId Int  @map("manager_id")
  manager   User @relation("TeamManager", fields: [managerId], references: [id])
  agents    User[] @relation("TeamAgents")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("teams")
}

model Lead {
  id             Int     @id @default(autoincrement())
  organizationId Int     @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])
  
  customerName   String  @map("customer_name")
  email          String? 
  phone          String  
  
  source         LeadSource
  status         LeadStatus @default(NEW)
  score          Int?       @default(0)
  aiSummary      String?    @map("ai_summary") @db.Text

  assignedToId Int?  @map("assigned_to")
  assignedTo   User? @relation("AssignedLeads", fields: [assignedToId], references: [id])

  calls      Call[]
  emails     Email[]
  tasks      Task[]         @relation("LeadTasks")
  activities LeadActivity[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([organizationId, email])
  @@unique([organizationId, phone])
  @@map("leads")
}

model Task {
  id          Int       @id @default(autoincrement())
  organizationId Int    @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])
  
  title       String
  description String?   @db.Text
  dueDate     DateTime? @map("due_date")
  priority    String?   @default("Normal")
  status      String?   @default("PENDING")
  
  type        String?   @default("FOLLOWUP")
  tags        String[]  @default([])
  notes       String?   @db.Text
  
  reminderTime DateTime? @map("reminder_time")
  isRecurring Boolean   @default(false) @map("is_recurring")
  recurringType String?  @map("recurring_type") // DAILY, WEEKLY, MONTHLY
  
  activityLogs Json?     @map("activity_logs")
  completedAt  DateTime? @map("completed_at")

  assignedToId Int      @map("assigned_to_id")
  assignedTo  User      @relation("TaskAssignee", fields: [assignedToId], references: [id])
  createdById Int?      @map("created_by_id")
  createdBy   User?     @relation("TaskCreator", fields: [createdById], references: [id])

  leadId Int?  @map("lead_id")
  lead   Lead? @relation("LeadTasks", fields: [leadId], references: [id])

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("tasks")
}

model Call {
  id              Int        @id @default(autoincrement())
  organizationId  Int        @map("organization_id")
  organization    Organization @relation(fields: [organizationId], references: [id])
  
  sid             String?    @unique
  leadId          Int?       @map("lead_id")
  agentId         Int        @map("agent_id")
  phone           String?
  status          String     @default("ringing")
  duration        Int        @default(0)
  recordingUrl    String?    @map("recording_url")
  
  createdAt       DateTime   @default(now()) @map("created_at")
  agent           User       @relation(fields: [agentId], references: [id])
  lead            Lead?      @relation(fields: [leadId], references: [id])
  qa              CallQA?

  @@map("calls")
}

model Invoice {
  id         Int           @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])
  
  invoiceNo  String        @unique @map("invoice_no")
  raisedById Int           @map("raised_by_id")
  raisedBy   User          @relation("InvoiceRaisedBy", fields: [raisedById], references: [id])
  amount     Float
  status     String        @default("PENDING")
  dueDate    DateTime      @map("due_date")
  
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")
  items      InvoiceItem[]

  @@map("invoices")
}

model InvoiceItem {
  id          Int     @id @default(autoincrement())
  invoiceId   Int     @map("invoice_id")
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int     @default(1)
  unitPrice   Float
  total       Float

  @@map("invoice_items")
}

// ==========================================
// 4. PLATFORM UTILITIES
// ==========================================

model OrganizationSetting {
  id        Int      @id @default(autoincrement())
  organizationId Int  @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])
  key       String
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([organizationId, key])
  @@map("organization_settings")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  organizationId Int?  @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id])
  userId    Int?     @map("user_id")
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  module    String
  details   Json?
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

model AIUsage {
  id        Int      @id @default(autoincrement())
  organizationId Int   @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  module    String
  tokens    Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("ai_usage")
}

model Email {
  id      Int   @id @default(autoincrement())
  organizationId Int @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])
  leadId  Int?  @map("lead_id")
  lead    Lead? @relation(fields: [leadId], references: [id])
  agentId Int   @map("agent_id")
  agent   User  @relation("AgentEmails", fields: [agentId], references: [id])
  
  subject      String
  content      String  @db.Text
  status       String  @default("SENT")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("emails")
}

model EmailAccount {
  id          Int      @id @default(autoincrement())
  organizationId Int   @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId      Int      @map("user_id")
  user        User     @relation(fields: [userId], references: [id])
  provider    String
  email       String   @unique
  password    String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("email_accounts")
}

model LeadActivity {
  id        Int      @id @default(autoincrement())
  organizationId Int @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])
  leadId    Int      @map("lead_id")
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  action    String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("lead_activities")
}

model CallQA {
  id        Int  @id @default(autoincrement())
  organizationId Int @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])
  callId    Int  @unique @map("call_id")
  call      Call @relation(fields: [callId], references: [id])
  managerId Int  @map("manager_id")
  manager   User @relation("QAManager", fields: [managerId], references: [id])
  score     Float
  createdAt DateTime @default(now()) @map("created_at")

  @@map("call_qa")
}

model Feedback {
  id        Int   @id @default(autoincrement())
  organizationId Int @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])
  agentId   Int   @map("agent_id")
  agent     User  @relation("AgentFeedback", fields: [agentId], references: [id])
  managerId Int   @map("manager_id")
  manager   User  @relation("ManagerFeedback", fields: [managerId], references: [id])
  content     String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("feedbacks")
}

model Invite {
  id             Int      @id @default(autoincrement())
  email          String   @unique
  token          String   @unique
  role           Role     @default(AGENT)
  status         String   @default("PENDING")
  organizationId Int      @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("invites")
}

enum LeadSource {
  WEBHOOK
  GOOGLE_ADS
  META
  WEBSITE
  CSV
  REFERRAL
  CALL
  API
}

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  QUALIFIED
  WON
  LOST
}
